# Template cấu hình môi trường.
#   copy .env.example .env      (Windows: Copy-Item .env.example .env)
#
# .env được docker compose tự đọc (cùng thư mục với docker-compose.yml).
# Spring Boot KHÔNG tự đọc .env: chạy `mvn spring-boot:run` thì phải export biến
# hoặc khai báo trong Run Configuration của IDE.
# .env đã nằm trong .gitignore. Không commit secret thật vào file này.

# ── Cổng publish ra host ─────────────────────────────────────────────────────
BACKEND_PORT=8080
# 3307 ở host để không đụng MySQL đang chạy sẵn trên máy (3306)
DB_HOST_PORT=3307

# ── MySQL container ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=ai_interview_db
# Dùng cho CẢ hai phía: mysql container tạo app user, và backend kết nối.
# Không được là root (image mysql từ chối MYSQL_USER=root).
# Lưu ý: MYSQL_USER chỉ có hiệu lực lần đầu khởi tạo volume — đổi user sau đó
# phải `docker compose down -v` rồi up lại.
DB_USERNAME=aiinterview
DB_PASSWORD=aiinterview

# ── Chỉ dùng khi chạy Spring Boot NGOÀI docker ───────────────────────────────
# docker compose bỏ qua 2 biến này (backend đã set cứng DB_HOST=db, DB_PORT=3306).
DB_HOST=localhost
DB_PORT=3307

# ── JWT ──────────────────────────────────────────────────────────────────────
# JwtUtil đọc thẳng System.getenv("JWT_ACCESS_SECRET" / "JWT_REFRESH_SECRET"),
# không đi qua application.yml — `app.jwt.secret` trong yml là config chết.
# Thiếu biến thì JwtUtil rơi về secret hard-code trong source.
# JJWT tự chọn thuật toán theo độ dài key: >=64 byte -> HS512, 48..63 -> HS384,
# 32..47 -> HS256. Bắt buộc >= 48 ký tự (HS384 là mức thấp nhất app từng phát
# hành token). Sinh secret mới bằng: openssl rand -hex 64
JWT_ACCESS_SECRET=8f3c1d9a4b7e2f6051c8ad3e97b46d02f5e1c7a94b8d3f6072e5a9c1d4b83f62
JWT_REFRESH_SECRET=c47e91b6d02a5f381e6b8d4c97f305ae3a92c5f81b6d7042e8f13a6c25d90b47

# ── Tài khoản seed sẵn cho Postman ───────────────────────────────────────────
# POST /api/v1/auth/register cần Gmail API để gửi mail xác thực; thiếu GMAIL_*
# thì EmailServiceImpl ném lỗi, transaction rollback -> 502. Vì vậy stack
# local/docker seed sẵn tài khoản đã verify. Production PHẢI để false.
APP_ADMIN_DEFAULT_PASSWORD=Admin@12345
APP_SEED_TEST_ACCOUNTS=true
APP_SEED_TEST_PASSWORD=Test@12345

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS nhận nhiều origin, phân tách bằng dấu phẩy.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── AI service (profile "ai" — không nằm trong `docker compose up` mặc định) ─
#   docker compose --profile ai up -d --build ai-service
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_AVATAR_SERVER=http://host.docker.internal:8010
AI_ALLOWED_ORIGIN=http://localhost:3000
AI_LLM_PROVIDER=template

# ── Scrape JD TopCV/ITviec (nút import trong admin) ──────────────────────────
TOPCV_IMPORT_LIMIT=10
TOPCV_PROXY_URL=
TOPCV_COOKIE=
TOPCV_SCRAPER_API_URL=

# ── Nhắc lịch phỏng vấn qua Gmail (mặc định tắt) ─────────────────────────────
INTERVIEW_REMINDER_ENABLED=false
INTERVIEW_REMINDER_CRON=0 */15 * * * *
INTERVIEW_REMINDER_WINDOW_MINUTES=15
INTERVIEW_REMINDER_LEAD_MINUTES=60

# ── Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID) ────
GOOGLE_CLIENT_ID=

# ── GitHub OAuth (GitHub -> Developer settings -> OAuth Apps) ────────────────
# callback: http://localhost:3000/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email ──
# Đường chính: SMTP Gmail + App Password (16 ký tự, chỉ tạo được khi đã bật 2FA:
#   myaccount.google.com/security -> 2-Step Verification -> App passwords).
# Có MAIL_USERNAME + MAIL_PASSWORD thì EmailServiceImpl gửi qua SMTP; bỏ trống mới rơi
# về Gmail API (OAuth) bên dưới. Lưu ý: một số PaaS free tier (Render) chặn outbound
# 25/465/587 — trên môi trường đó phải dùng Gmail API (HTTPS).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# App Password, KHÔNG phải mật khẩu đăng nhập Gmail (dán sai sẽ bị 535-5.7.8).
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Phải trùng MAIL_USERNAME, Gmail từ chối From khác hộp thư đã xác thực.
MAIL_FROM=

# APP_MAIL_DEV_LOG=true: không gửi mail, in nguyên nội dung (kèm link xác thực) ra log.
# Đặt true khi test local chưa có credential; production PHẢI để false, nếu không
# mail xác thực/reset password sẽ không bao giờ được gửi cho user thật.
APP_MAIL_DEV_LOG=false

# ── Gmail API (OAuth) — dự phòng khi không dùng được SMTP ──
#
# Cần khi không có SMTP (hoặc khi SMTP bị chặn). Prepare một lần
# (dùng chung Google Cloud project với Login with Google):
#   1. console.cloud.google.com -> APIs & Services -> Enable "Gmail API"
#   2. OAuth consent screen: thêm email gửi vào Test users, rồi chuyển
#      "In production" (để Testing thì refresh token hết hạn sau 7 ngày)
#   3. Credentials -> OAuth client ID (Web) -> lấy client id + secret
#   4. Lấy refresh token: https://developers.google.com/oauthplayground
#      (dán client id/secret, scope https://www.googleapis.com/auth/gmail.send)
# MAIL_FROM phải đúng hộp thư đã cấp refresh token — Gmail từ chối From khác (403).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=

# ── Enterprise SSO (OIDC generic IdP: Keycloak/Entra/Okta) ────────────────────
# Để trống = nút SSO tắt. SSO_ALLOWED_EMAIL_DOMAINS để trống = chấp nhận mọi
# domain đã verify; danh sách domain phân tách bằng dấu phẩy.
SSO_OIDC_ISSUER=http://localhost:8180/realms/ai-interview
SSO_OIDC_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ALLOWED_EMAIL_DOMAINS=acme.com
SSO_REDIRECT_URI=http://localhost:3000/login
