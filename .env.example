# Sao chép sang .env khi chạy local: cp .env.example .env
# Chạy local cần MySQL ở DB_PORT (Laragon hoặc docker compose trong repo deploy-staging).

# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=ai_interview_db
DB_USERNAME=root
DB_PASSWORD=admin123

# CORS - origin frontend được phép gọi API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=

# GitHub OAuth (GitHub Settings -> Developer settings -> OAuth Apps; callback http://localhost:3000/login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email qua Gmail API (HTTPS, không cần verify domain, không cần port SMTP).
# Lý do không dùng SMTP: Render free tier chặn outbound 25/465/587 (changelog 26/09/2025).
# Lý do không dùng Resend nữa: chế độ test của onboarding@resend.dev chỉ giao thư cho chủ tài
# khoản, nên user thật đăng ký không nhận được link xác thực.
#
# Prepare một lần (Google Cloud project đang dùng cho Login with Google):
#   1. console.cloud.google.com -> APIs & Services -> Enable "Gmail API"
#   2. OAuth consent screen: add chính email gửi vào Test users, rồi chuyển sang "In production"
#      (consent screen ở chế độ Testing thì refresh token hết hạn sau 7 ngày)
#   3. Credentials -> OAuth client ID (Web) -> lấy client id + secret
#   4. Lấy refresh token: https://developers.google.com/oauthplayground
#      (dán client id/secret, chọn scope https://www.googleapis.com/auth/gmail.send, exchange code)
# MAIL_FROM phải đúng là hộp thư đã cấp refresh token, Gmail từ chối From khác (403).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=

# Enterprise SSO (OIDC generic IdP: Keycloak/Entra/Okta). De trong = nut SSO tat
SSO_OIDC_ISSUER=http://localhost:8180/realms/ai-interview
SSO_OIDC_BASE_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ALLOWED_EMAIL_DOMAINS=acme.com
SSO_REDIRECT_URI=http://localhost:3000/login
