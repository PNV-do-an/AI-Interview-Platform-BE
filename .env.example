# Database (MySQL container trong docker-compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=ai_interview_db
DB_USERNAME=aiuser
DB_PASSWORD=aipassword
MYSQL_ROOT_PASSWORD=rootpass

# JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail (Gmail App Password 16 ký tự — bắt buộc "App Password", không phải mật khẩu Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Đặt false nếu chưa có mail config để backend không fail lúc khởi động
MAIL_TEST_CONNECTION=false

# AI (OpenAI)
OPENAI_API_KEY=sk-your-api-key-here
CV_UPLOAD_DIR=./uploads/cv
AUDIO_UPLOAD_DIR=./uploads/audio
